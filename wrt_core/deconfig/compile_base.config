# Compile
CONFIG_USE_APK=n
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# BUSYBOX
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_TELNET=y

# Proto
CONFIG_PACKAGE_proto-bonding=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-proto-relay=y

# Libraries
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_libopenssl-legacy=y

# Disable Package
CONFIG_PACKAGE_automount=n

#  DEFAULT SET
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y

#  Coremark
CONFIG_PACKAGE_coremark=y
CONFIG_COREMARK_OPTIMIZE_O3=y
CONFIG_COREMARK_ENABLE_MULTITHREADING=y
CONFIG_COREMARK_NUMBER_OF_THREADS=6

#  iptables nft
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y

# Package
CONFIG_PACKAGE_easytier=y

# Enable Luci App
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_EASYTIER_INCLUDE_WEBCONSOLE=n
CONFIG_PACKAGE_luci-app-istorex=y
CONFIG_PACKAGE_luci-app-lucky=n
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_luci-app-pbr=y
CONFIG_PACKAGE_luci-app-smartdns=n
CONFIG_PACKAGE_smartdns=n
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y

# eBPF 工具链：使用 host LLVM/clang（避免 /invalid/clang 编译失败）
CONFIG_BPF_TOOLCHAIN_HOST=y
# 关键！bpf.mk 判断 HAS_BPF_TOOLCHAIN 用 USE_LLVM_HOST（缺失则 clang=/invalid → daed 依赖不满足被跳过）
CONFIG_USE_LLVM_HOST=y
# daed 编译需要内核 BTF 调试信息（OpenWrt 内核选项必须是 CONFIG_KERNEL_ 前缀，裸符号会被 defconfig 丢弃）
CONFIG_KERNEL_DEBUG_INFO=y
# 【关键】必须关闭 REDUCED 精简模式！KERNEL_DEBUG_INFO_BTF 的 depends 是
# `KERNEL_DEBUG_INFO && !KERNEL_DEBUG_INFO_REDUCED`——VIKINGYFY 源码默认 REDUCED=y
# 导致 BTF 依赖不满足被 defconfig 静默丢弃 → 固件内核无 /sys/kernel/btf/vmlinux
# → daed(eBPF CO-RE) 启动 fatal: no BTF found，crash loop
CONFIG_KERNEL_DEBUG_INFO_REDUCED=n
CONFIG_KERNEL_DEBUG_INFO_BTF=y

# daed (dae eBPF) 依赖的内核模块 —— 缺失会导致 menuconfig 跳过 daed 包（固件里没有 daed）
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
# 内核侧 BPF/XDP 选项
CONFIG_NET_SCH_BPF=y
CONFIG_XDP_SOCKETS=y
CONFIG_XDP_SOCKETS_DIAG=y
