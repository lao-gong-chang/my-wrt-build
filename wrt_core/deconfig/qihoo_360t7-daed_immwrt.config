# TARGET config - 360T7 (MT7981B) DAED 版（给 512M 内存款）
# 实测设备: 内存 492MB, mtd5 ubi = 108M (H大 108M UBI 大分区布局)
# 512M 内存: daed (eBPF) 可跑，性能最好（需 ImmortalWrt 25.12 内核 BTF 支持）
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_qihoo_360t7-ubi=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_qihoo_360t7-ubi=""
CONFIG_TARGET_ROOTFS_INITRAMFS=n

# Kernel modules
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-tls=y

# Package
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_qrencode=y
CONFIG_PACKAGE_xz-utils=y

# User custom packages (512M RAM -> daed 可用)
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-daed=y
CONFIG_PACKAGE_daed=y

# Disable smartdns (upstream default pulls it, download source 404)
CONFIG_PACKAGE_smartdns=n
CONFIG_PACKAGE_luci-app-smartdns=n
